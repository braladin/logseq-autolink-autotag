{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Automerge patch updates after CI succeeds",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Keep Jest on v29 after npm audit fix --force downgraded it from v30",
      "matchManagers": ["npm"],
      "matchPackageNames": ["jest"],
      "allowedVersions": "<30"
    }
  ]
}
